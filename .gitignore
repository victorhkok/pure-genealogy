# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/docker-output/
/backups/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env
.env.self-hosted

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地自托管运维产物（回滚备份 / 构建日志 / macOS 元数据，不纳入版本控制）
*.pre-batch-edit
*.pre-3dfix
*.bak
logs/
logs-build-*.txt
._*
# 数据库备份 dump 含业务数据，禁止入库；保留在本地磁盘 / iCloud 备份中
backups/
*.dump
